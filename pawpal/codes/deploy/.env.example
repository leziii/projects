# E15-2: copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# --- Web addresses (R62-2). Point both at this server's IP in your domain's DNS first.
APP_DOMAIN=app.pawpal.my
ADMIN_DOMAIN=admin.pawpal.my
# Certificate notices from Let's Encrypt go here.
TLS_EMAIL=you@example.com
# Leave empty on a real server. Only for a test on your own PC: "local_certs" makes Caddy use its own certificates.
CADDY_GLOBAL=

# --- staging or production (R62-4). Staging allows the test gateway, test SMS and Test tools; production refuses them.
NODE_ENV=staging

# --- Database password: any long random text (openssl rand -base64 24). Set once; changing it later needs a database change too.
DB_PASSWORD=

# --- Keys. Generate once and never change them (owner addresses and IC numbers are encrypted with ADDRESS_KEY).
# ADDRESS_KEY: openssl rand -base64 32
ADDRESS_KEY=
# Web push keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Services. Staging: mock. Production: the real providers (E15-1, E15-5).
PAYMENT_GATEWAY=mock
MOCK_GATEWAY_SECRET=
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock

# Support WhatsApp number with country code, e.g. 60123456789.
SUPPORT_WHATSAPP=

# --- Error tracking (E15-3). Empty = off.
SENTRY_DSN=

# --- Test tools password (staging). Browser asks for it on admin → Test tools.
# Make the hash with: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
DEV_TOOLS_USER=tester
DEV_TOOLS_HASH=

# --- Backups (R62-3): hour in KL time, days kept, and (later) an S3 bucket for a copy off the server.
BACKUP_HOUR=3
BACKUP_DAYS=14
BACKUP_S3=
