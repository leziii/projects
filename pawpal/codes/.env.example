# Copy to server/.env and change if needed
PORT=3000
DATABASE_URL=postgres://pawpal:pawpal@localhost:5433/pawpal
REDIS_URL=redis://localhost:6379
# Payments: "mock" until the real gateway is chosen (E15-1). The mock cannot run in production.
PAYMENT_GATEWAY=mock
MOCK_GATEWAY_SECRET=dev-mock-secret
# SMS: "mock" shows login codes on screen instead of sending them. The real provider is chosen before the pilot.
SMS_PROVIDER=mock
# WhatsApp alerts: "mock" logs them instead of sending (SMS is the fallback). The real provider is chosen before the pilot.
WHATSAPP_PROVIDER=mock
# Web push keys. Leave empty in development: the server makes a pair once and keeps it in the database.
# Production must set both (generate with: npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Only if this computer reaches the internet through a proxy (push alerts then time out): e.g. http://127.0.0.1:7890
PUSH_PROXY=
# Support WhatsApp number for the help button, with country code (e.g. 60123456789).
# Empty: a placeholder outside production; production shows "support not set".
SUPPORT_WHATSAPP=
# Private uploads (vaccine card photos) in development: a folder on this PC. Cloud storage replaces it when hosting is chosen.
UPLOAD_DIR=uploads
# Key for encrypting owner addresses and contacts: 32 random bytes in base64 (openssl rand -base64 32).
# Empty in development: the server makes one and keeps it in the database. Production must set it, and never change it.
ADDRESS_KEY=
