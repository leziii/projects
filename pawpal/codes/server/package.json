{
  "name": "@pawpal/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "admin:create": "tsc -p tsconfig.build.json && node dist/admin/create-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@pawpal/shared": "workspace:*",
    "ioredis": "^5.4.1",
    "pg": "^8.23.1",
    "qrcode-terminal": "0.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.9.2",
    "@types/express": "^5.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode-terminal": "0.12.2",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "3.6.4",
    "supertest": "^7.0.0",
    "tsc-watch": "^7.2.1",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.9"
  }
}
